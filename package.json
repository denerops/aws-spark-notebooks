{
  "name": "emr-serverless-pyspark",
  "displayName": "AWS Spark Notebooks",
  "description": "Run PySpark and Spark SQL in .sparknb and .ipynb notebooks on EMR Serverless and AWS Glue Interactive Sessions via Apache Livy",
  "version": "0.8.0",
  "publisher": "denerops",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denerops/aws-spark-notebooks.git"
  },
  "bugs": {
    "url": "https://github.com/denerops/aws-spark-notebooks/issues"
  },
  "homepage": "https://github.com/denerops/aws-spark-notebooks#readme",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Notebooks",
    "Data Science"
  ],
  "keywords": [
    "aws",
    "emr",
    "serverless",
    "spark",
    "pyspark",
    "livy",
    "notebook",
    "glue",
    "interactive-sessions"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onNotebook:emr-spark",
    "onNotebookSerializer:emr-spark",
    "onRenderer:emr-spark-table-renderer",
    "onView:emrServerlessApplications",
    "onView:emrServerlessConfig",
    "onView:glueInteractiveSessions"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "*.ipynb": "emr-spark"
      }
    },
    "notebooks": [
      {
        "type": "emr-spark",
        "displayName": "AWS Spark Notebook",
        "selector": [
          {
            "filenamePattern": "*.sparknb"
          },
          {
            "filenamePattern": "*.ipynb",
            "priority": "default"
          }
        ]
      }
    ],
    "notebookRenderer": [
      {
        "id": "emr-spark-table-renderer",
        "displayName": "Spark DataFrame Result",
        "entrypoint": "./dist/tableRenderer.js",
        "mimeTypes": [
          "application/vnd.emr-spark.table+json",
          "application/vnd.emr-spark.error+json"
        ],
        "requiresMessaging": "optional"
      }
    ],
    "commands": [
      {
        "command": "emrServerless.openNotebook",
        "title": "Open with EMR Serverless PySpark",
        "category": "EMR Serverless"
      },
      {
        "command": "emrServerless.newNotebook",
        "title": "New EMR Serverless Notebook",
        "category": "EMR Serverless"
      },
      {
        "command": "emrServerless.connect",
        "title": "Connect to EMR Serverless Session",
        "category": "EMR Serverless"
      },
      {
        "command": "emrServerless.selectKernel",
        "title": "Select EMR Serverless Session",
        "category": "EMR Serverless"
      },
      {
        "command": "emrServerless.disconnect",
        "title": "Disconnect Notebook Session",
        "category": "EMR Serverless"
      },
      {
        "command": "emrServerless.selectAwsProfile",
        "title": "Select AWS Profile",
        "category": "EMR Serverless"
      },
      {
        "command": "emrServerless.selectAwsRegion",
        "title": "Select AWS Region",
        "category": "EMR Serverless"
      },
      {
        "command": "emrServerless.refreshApplications",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "EMR Serverless"
      },
      {
        "command": "emrServerless.verifyAwsCredentials",
        "title": "Verify AWS Credentials",
        "icon": "$(debug-console)",
        "category": "EMR Serverless"
      },
      {
        "command": "emrServerless.startApplication",
        "title": "Start Application",
        "icon": "$(play)",
        "category": "EMR Serverless"
      },
      {
        "command": "emrServerless.stopApplication",
        "title": "Stop Application",
        "icon": "$(debug-stop)",
        "category": "EMR Serverless"
      },
      {
        "command": "emrServerless.restartApplication",
        "title": "Restart Application",
        "icon": "$(debug-restart)",
        "category": "EMR Serverless"
      },
      {
        "command": "emrServerless.attachSession",
        "title": "Attach to Session",
        "icon": "$(link)",
        "category": "EMR Serverless"
      },
      {
        "command": "emrServerless.stopSession",
        "title": "Stop Session",
        "icon": "$(debug-stop)",
        "category": "EMR Serverless"
      },
      {
        "command": "emrServerless.newSession",
        "title": "New Session",
        "icon": "$(add)",
        "category": "EMR Serverless"
      },
      {
        "command": "emrServerless.refreshDashboard",
        "title": "Refresh Spark UI Link",
        "category": "EMR Serverless"
      },
      {
        "command": "emrServerless.openSparkUi",
        "title": "Open Spark UI",
        "icon": "$(globe)",
        "category": "EMR Serverless"
      },
      {
        "command": "emrServerless.openSessionPresets",
        "title": "Focus Config",
        "category": "EMR Serverless"
      },
      {
        "command": "emrServerless.editSessionPreset",
        "title": "Edit Session Preset",
        "category": "EMR Serverless"
      },
      {
        "command": "emrServerless.newSessionPreset",
        "title": "New Session Preset",
        "icon": "$(add)",
        "category": "EMR Serverless"
      },
      {
        "command": "emrServerless.refreshConfig",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "EMR Serverless"
      },
      {
        "command": "emrServerless.openWorkspacePresetsFile",
        "title": "Open Workspace Presets File",
        "icon": "$(repo)",
        "category": "EMR Serverless"
      },
      {
        "command": "emrServerless.exportPresetsToWorkspace",
        "title": "Export Personal Presets to Workspace",
        "category": "EMR Serverless"
      },
      {
        "command": "emrServerless.openWelcome",
        "title": "Help",
        "icon": "$(question)",
        "category": "EMR Serverless"
      },
      {
        "command": "glueInteractive.refreshSessions",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Glue Interactive"
      },
      {
        "command": "glueInteractive.newSession",
        "title": "New Glue Session",
        "icon": "$(add)",
        "category": "Glue Interactive"
      },
      {
        "command": "glueInteractive.attachSession",
        "title": "Attach to Glue Session",
        "icon": "$(link)",
        "category": "Glue Interactive"
      },
      {
        "command": "glueInteractive.stopSession",
        "title": "Stop Glue Session",
        "icon": "$(debug-stop)",
        "category": "Glue Interactive"
      },
      {
        "command": "glueInteractive.deleteSession",
        "title": "Delete Glue Session",
        "icon": "$(trash)",
        "category": "Glue Interactive"
      },
      {
        "command": "glueInteractive.openSparkUi",
        "title": "Open Spark UI",
        "icon": "$(globe)",
        "category": "Glue Interactive"
      },
      {
        "command": "glueInteractive.connect",
        "title": "Connect to Glue Session",
        "category": "Glue Interactive"
      },
      {
        "command": "glueInteractive.editSessionPreset",
        "title": "Edit Glue Session Preset",
        "category": "Glue Interactive"
      },
      {
        "command": "glueInteractive.newSessionPreset",
        "title": "New Glue Session Preset",
        "icon": "$(add)",
        "category": "Glue Interactive"
      },
      {
        "command": "glueInteractive.openWorkspacePresetsFile",
        "title": "Open Glue Workspace Presets File",
        "icon": "$(repo)",
        "category": "Glue Interactive"
      },
      {
        "command": "glueInteractive.exportPresetsToWorkspace",
        "title": "Export Personal Glue Presets to Workspace",
        "category": "Glue Interactive"
      },
      {
        "command": "glueInteractive.openSessionPresets",
        "title": "Focus Config",
        "category": "Glue Interactive"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "emr-serverless-explorer",
          "title": "AWS Spark",
          "icon": "media/emr-serverless-mono.svg"
        }
      ]
    },
    "views": {
      "emr-serverless-explorer": [
        {
          "id": "emrServerlessApplications",
          "name": "EMR Applications",
          "icon": "media/emr-serverless-mono.svg"
        },
        {
          "id": "glueInteractiveSessions",
          "name": "Glue Sessions",
          "icon": "$(cloud)"
        },
        {
          "id": "emrServerlessConfig",
          "name": "Config",
          "icon": "$(settings-gear)"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "emrServerless.openNotebook",
          "when": "resourceExtname == .ipynb",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "emrServerless.openNotebook"
        },
        {
          "command": "emrServerless.newNotebook"
        },
        {
          "command": "emrServerless.connect"
        },
        {
          "command": "emrServerless.selectKernel"
        },
        {
          "command": "emrServerless.disconnect"
        },
        {
          "command": "emrServerless.refreshApplications"
        },
        {
          "command": "emrServerless.verifyAwsCredentials"
        },
        {
          "command": "emrServerless.openSessionPresets"
        },
        {
          "command": "emrServerless.openWorkspacePresetsFile"
        },
        {
          "command": "emrServerless.exportPresetsToWorkspace"
        },
        {
          "command": "emrServerless.refreshDashboard"
        },
        {
          "command": "emrServerless.openSparkUi"
        },
        {
          "command": "emrServerless.openWelcome"
        }
      ],
      "view/title": [
        {
          "command": "emrServerless.refreshConfig",
          "when": "view == emrServerlessConfig",
          "group": "navigation"
        },
        {
          "command": "emrServerless.openWorkspacePresetsFile",
          "when": "view == emrServerlessConfig",
          "group": "navigation@3"
        },
        {
          "command": "emrServerless.openWelcome",
          "when": "view == emrServerlessConfig",
          "group": "navigation@99"
        },
        {
          "command": "emrServerless.openWelcome",
          "when": "view == emrServerlessApplications",
          "group": "navigation@99"
        },
        {
          "command": "glueInteractive.refreshSessions",
          "when": "view == glueInteractiveSessions",
          "group": "navigation"
        },
        {
          "command": "glueInteractive.newSession",
          "when": "view == glueInteractiveSessions",
          "group": "navigation"
        },
        {
          "command": "emrServerless.openWelcome",
          "when": "view == glueInteractiveSessions",
          "group": "navigation@99"
        },
        {
          "command": "emrServerless.refreshApplications",
          "when": "view == emrServerlessApplications",
          "group": "navigation"
        },
        {
          "command": "emrServerless.verifyAwsCredentials",
          "when": "view == emrServerlessApplications",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "emrServerless.newSessionPreset",
          "when": "view == emrServerlessConfig && viewItem == emrPresetsRoot",
          "group": "inline@1"
        },
        {
          "command": "glueInteractive.newSessionPreset",
          "when": "view == emrServerlessConfig && viewItem == gluePresetsRoot",
          "group": "inline@1"
        },
        {
          "command": "emrServerless.startApplication",
          "when": "view == emrServerlessApplications && viewItem == applicationStopped",
          "group": "inline@1"
        },
        {
          "command": "emrServerless.stopApplication",
          "when": "view == emrServerlessApplications && (viewItem == applicationRunning || viewItem == applicationStarting)",
          "group": "inline@1"
        },
        {
          "command": "emrServerless.restartApplication",
          "when": "view == emrServerlessApplications && viewItem == applicationRunning",
          "group": "1_actions@2"
        },
        {
          "command": "emrServerless.attachSession",
          "when": "view == emrServerlessApplications && viewItem == session",
          "group": "inline@1"
        },
        {
          "command": "emrServerless.openSparkUi",
          "when": "view == emrServerlessApplications && viewItem == session",
          "group": "inline@2"
        },
        {
          "command": "emrServerless.stopSession",
          "when": "view == emrServerlessApplications && (viewItem == session || viewItem == sessionStarting)",
          "group": "2_destructive@1"
        },
        {
          "command": "emrServerless.newSession",
          "when": "view == emrServerlessApplications && viewItem == applicationRunning",
          "group": "1_actions@1"
        },
        {
          "command": "glueInteractive.attachSession",
          "when": "view == glueInteractiveSessions && viewItem == sessionReady",
          "group": "inline@1"
        },
        {
          "command": "glueInteractive.stopSession",
          "when": "view == glueInteractiveSessions && (viewItem == sessionReady || viewItem == sessionProvisioning || viewItem == session)",
          "group": "2_destructive@1"
        },
        {
          "command": "glueInteractive.deleteSession",
          "when": "view == glueInteractiveSessions && (viewItem == sessionReady || viewItem == sessionProvisioning || viewItem == session || viewItem == sessionStopped)",
          "group": "2_destructive@2"
        }
      ]
    },
    "configuration": [
      {
        "title": "EMR Serverless",
        "properties": {
          "emrServerless.defaultExecutionRoleArn": {
            "type": "string",
            "default": "",
            "description": "IAM role passed to Livy session conf (iam:PassRole required)."
          },
          "emrServerless.sessionConfigsDefaults": {
            "type": "object",
            "default": {
              "driverMemory": "4G",
              "executorMemory": "16G",
              "executorCores": 4,
              "numExecutors": 1,
              "conf": {
                "emr-serverless.session.executionRoleArn": "arn:aws:iam::123456789012:role/EMRServerlessExecutionRole",
                "spark.dynamicAllocation.enabled": "false",
                "spark.executor.instances": "1",
                "spark.emr-serverless.executor.disk": "40G",
                "spark.sql.extensions": "org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions",
                "spark.sql.catalog.spark_catalog": "org.apache.iceberg.spark.SparkSessionCatalog",
                "spark.sql.catalog.spark_catalog.type": "glue"
              }
            },
            "description": "Default Livy POST /sessions body fields when starting a new session."
          },
          "emrServerless.statementPollIntervalMs": {
            "type": "number",
            "default": 500,
            "description": "Poll interval when waiting for Livy statement completion."
          },
          "emrServerless.sessionStartupTimeoutSeconds": {
            "type": "number",
            "default": 600,
            "description": "Timeout when waiting for a new Livy session to become ready."
          },
          "emrServerless.maxRows": {
            "type": "number",
            "default": 1000,
            "description": "Maximum rows to display in DataFrame table outputs."
          },
          "emrServerless.dashboardRefreshHintMinutes": {
            "type": "number",
            "default": 55,
            "description": "Hint shown before Spark UI dashboard URLs expire (~1 hour)."
          },
          "emrServerless.icebergCatalog.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Merge Iceberg/Glue catalog Spark conf when creating new Livy sessions."
          },
          "emrServerless.icebergCatalog.catalogName": {
            "type": "string",
            "default": "spark_catalog",
            "description": "Primary Iceberg catalog name (SparkSessionCatalog on Glue uses spark_catalog)."
          },
          "emrServerless.icebergCatalog.sessionConf": {
            "type": "object",
            "default": {
              "spark.sql.extensions": "org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions",
              "spark.sql.catalog.spark_catalog": "org.apache.iceberg.spark.SparkSessionCatalog",
              "spark.sql.catalog.spark_catalog.type": "glue"
            },
            "description": "Primary Spark session conf merged into every new Livy session."
          },
          "emrServerless.icebergCatalog.additionalCatalogConf": {
            "type": "object",
            "default": {},
            "description": "Extra spark.sql.catalog.* keys merged at session start (e.g. a named glue_catalog with warehouse)."
          },
          "emrServerless.icebergCatalog.glueCatalog": {
            "type": "object",
            "default": {
              "enabled": false,
              "name": "glue_catalog",
              "warehouse": ""
            },
            "description": "Optional second Iceberg catalog (SparkCatalog + GlueCatalog). Set warehouse to s3://bucket/ and enabled true. Merged at session start alongside spark_catalog."
          },
          "emrServerless.sessionPresets.workspaceFile": {
            "type": "string",
            "default": ".vscode/emr-serverless-presets.json",
            "description": "Path relative to the workspace folder for team-shared session presets (version-controlled)."
          },
          "emrServerless.sessionPresets.preferWorkspace": {
            "type": "boolean",
            "default": true,
            "description": "When creating new presets, default to the workspace file when a folder is open."
          },
          "emrServerless.awsProfile": {
            "type": "string",
            "default": "",
            "description": "AWS shared config profile for EMR Serverless API calls. Empty uses the default credential chain (AWS_PROFILE environment variable, then default)."
          },
          "emrServerless.awsRegion": {
            "type": "string",
            "default": "",
            "description": "AWS region for EMR Serverless API calls. Empty uses the region from the selected AWS profile (~/.aws/config) or AWS_REGION. Change it in the Config sidebar view."
          }
        }
      },
      {
        "title": "Glue Interactive Sessions",
        "properties": {
          "glueInteractive.defaultRoleArn": {
            "type": "string",
            "default": "",
            "description": "IAM role passed to Glue CreateSession (iam:PassRole required)."
          },
          "glueInteractive.sessionDefaults": {
            "type": "object",
            "default": {
              "glueVersion": "4.0",
              "workerType": "G.1X",
              "numberOfWorkers": 2,
              "idleTimeout": 30,
              "pythonVersion": "3",
              "defaultArguments": {
                "--enable-glue-datacatalog": "true",
                "spark.sql.extensions": "org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions",
                "spark.sql.catalog.spark_catalog": "org.apache.iceberg.spark.SparkSessionCatalog",
                "spark.sql.catalog.spark_catalog.type": "glue"
              },
              "tags": {}
            },
            "description": "Default Glue CreateSession fields when starting a new Livy session."
          },
          "glueInteractive.statementPollIntervalMs": {
            "type": "number",
            "default": 500,
            "description": "Poll interval when waiting for Glue RunStatement completion."
          },
          "glueInteractive.sessionStartupTimeoutSeconds": {
            "type": "number",
            "default": 600,
            "description": "Timeout when waiting for a new Glue session to reach READY."
          },
          "glueInteractive.sessionPresets.workspaceFile": {
            "type": "string",
            "default": ".vscode/glue-interactive-presets.json",
            "description": "Path relative to the workspace folder for team-shared Glue session presets."
          },
          "glueInteractive.sessionPresets.preferWorkspace": {
            "type": "boolean",
            "default": true,
            "description": "When creating new Glue presets, default to the workspace file when a folder is open."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@types/node": "^22.15.21",
    "@types/vscode": "^1.88.0",
    "@types/vscode-notebook-renderer": "^1.72.4",
    "@vscode/vsce": "^3.9.2",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "esbuild": "^0.25.5",
    "semantic-release": "^24.2.9",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-emr-serverless": "^3.821.0",
    "@aws-sdk/client-glue": "^3.1078.0",
    "@aws-sdk/credential-providers": "^3.821.0",
    "@smithy/node-http-handler": "^4.0.4",
    "@smithy/protocol-http": "^5.1.2",
    "@smithy/shared-ini-file-loader": "^4.0.4",
    "@smithy/signature-v4": "^5.5.2",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "undici": "^7.10.0"
  }
}
